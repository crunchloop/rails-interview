<div class="flex-1 w-full md:max-w-3xl mx-auto px-4 sm:px-5 py-8 md:py-12 lg:py-20">
  <div class="text-center mb-8 md:mb-10" style="opacity: 1; transform: none;">
    <div class="items-center justify-between mb-5 md:block">
      <div class="inline-flex items-center justify-center w-14 h-14 md:w-16 md:h-16 bg-white rounded-2xl shadow-sm border border-slate-100">
        <%= icon("list-todo", class: "w-7 h-7 md:w-8 md:h-8 text-slate-700") %>
      </div>
      <div class="w-10 md:hidden"></div>
    </div>
    <h1 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-slate-800 tracking-tight">My Tasks</h1>
    <p class="text-sm md:text-base text-slate-500 mt-2">Stay organized, stay productive</p>
  </div>
  <div class="flex items-center justify-center gap-6 mb-8" style="opacity: 1;">
    <div class="flex items-center gap-2 text-sm text-slate-500">
      <%= icon("circle", class: "w-4 h-4") %>
      <span>2 pending</span>
    </div>
    <div class="w-px h-4 bg-slate-200"></div>
    <div class="flex items-center gap-2 text-sm text-slate-500">
      <%= icon("circle-check", class: "w-4 h-4") %>
      <span>0 completed</span>
    </div>
  </div>
  <div class="mb-6">
    <form class="relative">
      <div class="flex items-center gap-3 bg-white rounded-2xl border border-slate-200 p-2 transition-colors duration-300" style="box-shadow: rgba(0, 0, 0, 0.04) 0px 1px 3px;">
        <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center">
          <%= icon("plus", class: "w-5 h-5 text-slate-400") %>
        </div>
        <input type="text" placeholder="Add a new task..." class="flex-1 bg-transparent text-slate-700 placeholder:text-slate-400 outline-none text-base py-2" value="">
      </div>
    </form>
  </div>
  <div class="space-y-3">
    <div class="group flex items-center gap-4 p-4 bg-white rounded-2xl border border-slate-100 hover:border-slate-200 hover:shadow-sm transition-all duration-300" style="opacity: 1; transform: none; transform-origin: 50% 50% 0px;">
      <button class="flex-shrink-0 w-6 h-6 rounded-full border-2 flex items-center justify-center transition-all duration-300 border-slate-300 hover:border-slate-400"></button>
      <div class="flex-1 flex items-center gap-2">
        <span class="text-base transition-all duration-300 text-slate-700">Sarasa</span>
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs font-medium bg-purple-100 text-purple-700">
          <%= icon("user", class: "w-3 h-3") %>
          Personal
        </span>
      </div>
      <button class="opacity-0 group-hover:opacity-100 p-2 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-all duration-200">
        <%= icon("trash2", class: "w-4 h-4") %>
      </button>
    </div>
    <div class="group flex items-center gap-4 p-4 bg-white rounded-2xl border border-slate-100 hover:border-slate-200 hover:shadow-sm transition-all duration-300" style="opacity: 1; transform: none; transform-origin: 50% 50% 0px;">
      <button class="flex-shrink-0 w-6 h-6 rounded-full border-2 flex items-center justify-center transition-all duration-300 border-slate-300 hover:border-slate-400"></button>
      <div class="flex-1 flex items-center gap-2"><span class="text-base transition-all duration-300 text-slate-700">Second</span></div>
      <button class="opacity-0 group-hover:opacity-100 p-2 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-all duration-200">
        <%= icon("trash2", class: "w-4 h-4") %>
      </button>
    </div>
  </div>
</div>
