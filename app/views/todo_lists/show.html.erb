<div class="page-header">
  <h1><%= @todo_list.name %></h1>

  <div class="header-actions">
    <%= link_to t('.back'), todo_lists_path, class: "link" %>
  </div>
</div>

<% if notice %>
  <p class="notice"><%= notice %></p>
<% end %>

<% if alert %>
  <p class="alert"><%= alert %></p>
<% end %>

<% if @todo_list.processing? %>
  <div class="alert">
    <%= t('.processing') %>
  </div>
<% end %>

<% if @todo_list.failed? %>
  <div class="alert">
    <%= t('.failed') %>
  </div>
<% end %>


<div class="card">
  <div class="card-header">
    <h2><%= t('.items') %></h2>

    <% if @todo_list.todo_items.any? %>
      <%= button_to(
        t('.mark_all'),
        mark_all_todo_items_as_complete_todo_list_path(@todo_list),
        method: :post,
        class: "button",
        disabled: @todo_list.processing? || !@todo_list.has_uncompleted_items?
      ) %>
    <% end %>
  </div>

  <% if @todo_list.todo_items.any? %>
    <ul class="todo-items">
      <% @todo_list.todo_items.limit(100).each do |todo_item| %>
        <li class="todo-item <%= 'completed' if todo_item.complete? %>">
          <div class='row'>
            <% if todo_item.complete? %>
              <i class="fa fa-check-square <%= 'disabled' if todo_item.complete? %>"></i>
            <% else %>
              <%= button_to(
                    mark_as_complete_todo_list_todo_item_path(@todo_list, todo_item),
                    method: :patch
                  ) do %>
                <i class="fa fa-square-o"></i>
              <% end %>
            <% end %>
            <span><%= todo_item.title %></span>
          </div>
          <div class="row">
            <%= link_to todo_list_todo_item_path(@todo_list, todo_item) do %>
              <i class="fa fa-eye"></i>
            <% end %>

            <%= link_to edit_todo_list_todo_item_path(@todo_list, todo_item) do %>
              <i class="fa fa-pencil"></i>
            <% end %>

            <%= button_to(
                  todo_list_todo_item_path(@todo_list, todo_item),
                  method: :delete,
                  class: "trash",
                  data: { turbo_confirm: t('.confirm_delete') }
                ) do %>
              <i class="fa fa-trash"></i>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty"><%= t('.empty') %></p>
  <% end %>
</div>

<%= link_to t('.add_item'),
  new_todo_list_todo_item_path(@todo_list),
  class: "button" %>