<div class="todo-list-form">
  <h1>Edit Todo List</h1>

  <%= form_with(model: @todo_list, url: todo_list_path(@todo_list)) do |form| %>
    <% if @todo_list.errors.any? %>
      <div id="error_explanation">
        <h2><%= pluralize(@todo_list.errors.count, "error") %> prohibited this todo list from being saved:</h2>
        <ul>
          <% @todo_list.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="todo-list-form__group">
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>

    <div class="todo-list-form__actions">
      <%= form.submit "Update Todo List", class: 'btn btn--primary' %>
      <%= link_to 'Back', todo_lists_path, class: 'btn btn--secondary todo-list-form__back' %>
    </div>
  <% end %>
</div>
