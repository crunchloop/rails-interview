<header class="page-header">
  <h1><%= t('.title') %></h1>
  <%= link_to t('.add'), new_todo_list_path, class: 'button' %>
</header>

<section>
  <% @todo_lists.each do |todo_list| %>
    <div class="card">
      <div class="card-header">
        <h2 class="list-title"><%= todo_list.name %></h2>
        <span class="list-id">#<%= todo_list.id %></span>
      </div>

      <div class="card-actions">
        <%= link_to t('.add_item'), new_todo_list_todo_item_path(todo_list), class: 'link' %>
        <%= link_to t('.view_list'), todo_list_path(todo_list), class: 'link primary' %>
      </div>
    </div>
  <% end %>
</section>
