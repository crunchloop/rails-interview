<%= link_to 'Add NEW Todo List', new_todo_list_path %>

<%= button_to 'Generate 3 TodoList with random TodoItems inside', generate_lists_todo_lists_path, method: :post, data: { confirm: '¿Are you sure to create 30,000 TodoLists?' } %>
<div>
  <p>Total TodoLists: <%= @todo_list_count %></p>  <!-- Mostrar el número total de TodoLists -->
</div>

<div>
  <% @todo_lists.each do |todo_list| %>
    <div>
    <%= link_to todo_list_path(todo_list) do %>
      <strong>TodoList #<%= todo_list.id %></strong> | <%= todo_list.name %>
    <% end %>
      <% if todo_list.todo_items.any? %>
        <ul>
          <% todo_list.todo_items.each do |item| %>
            <li>
              <strong>TodoItem:</strong> <%= item.name %> - <%= item.description %> (Complete: <%= item.is_completed %>)
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No TodoItems found for this TodoList.</p>
      <% end %>

    </div>
    <hr>
  <% end %>
</div>
