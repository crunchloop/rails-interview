<!DOCTYPE html>
<html>
  <head>
    <title>RailsInterview</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <nav class="bg-white/70 backdrop-blur-[10px] border-b border-black/[0.08] px-6 py-3 flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center gap-4">
          <span class="text-sm font-bold text-[#1e1e1e]"><%= current_user.email %></span>
        </div>
        <div>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-xs font-bold text-gray-500 hover:text-[#1e1e1e] transition-colors bg-transparent border-0 cursor-pointer p-0" %>
        </div>
      </nav>
    <% end %>

    <%= yield %>
  </body>
</html>
