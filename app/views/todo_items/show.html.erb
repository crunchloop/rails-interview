<div class="page-header">
  <h1><%= t('.title') %></h1>
  <%= link_to t('.back'), @todo_list, class: "link" %>
</div>

<% if notice %>
  <p class="notice"><%= notice %></p>
<% end %>

<% if alert %>
  <p class="alert"><%= alert %></p>
<% end %>

<div class="card todo-item-card">
  <div class="item">
    <span class="label"><%= t('.fields.title') %></span>
    <span class="value"><%= @todo_item.title %></span>
  </div>

  <div class="item">
    <span class="label"><%= t('.fields.description') %></span>
    <span class="value"><%= @todo_item.description %></span>
  </div>

  <div class="item">
    <span class="label"><%= t('.fields.status') %></span>
    <% if @todo_item.complete? %>
      <span class="status completed"><%= t('.status.completed') %></span>
    <% else %>
      <span class="status pending"><%= t('.status.pending') %></span>
    <% end %>
  </div>
</div>

<div class="page-actions">
  <%= link_to t('.edit'),
    edit_todo_list_todo_item_path(@todo_list, @todo_item),
    class: "button",
    disabled: @todo_list.processing?
  %>

  <%= button_to t('.delete'),
    todo_list_todo_item_path(@todo_list, @todo_item),
    method: :delete,
    class: "button danger",
    disabled: @todo_list.processing?,
    data: { turbo_confirm: t('.confirm_delete') }
  %>
</div>
