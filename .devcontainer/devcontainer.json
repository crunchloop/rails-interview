{
  "name": "crunchloop-rails-interview",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",

  "workspaceFolder": "/workspaces/rails-interview",

  "forwardPorts": [3000],

  "postCreateCommand": "bundle install && bin/rails db:setup",

  "postStartCommand": "rm -f tmp/pids/server.pid && bin/dev",

  "customizations": {
    "vscode": {
      "extensions": ["Postman.postman-for-vscode"]
    }
  }
}